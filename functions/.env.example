# ShanGo Real-time Background Dispatcher Environment Variables

# Optional: HTTP health check port (defaults to 8080)
PORT=8080

# For Railway / Render / Cloud Hosting:
# Paste the entire content of your serviceAccountKey.json as a single-line string or base64
# Example: FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"shango-46a70",...}
FIREBASE_SERVICE_ACCOUNT=
